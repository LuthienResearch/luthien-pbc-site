{
  "name": "luthien-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "routes": [
    // Single wildcard pattern matches /pitch, /pitch/, /pitch/anything, /pitch.pdf,
    // and any of those with a query string. Cloudflare patterns without `*` only
    // match a literal URL with no query string.
    { "pattern": "luthien.cc/pitch*", "zone_name": "luthien.cc" }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TRACKER_HITS",
      "dataset": "luthien_tracker_hits"
    }
  ]
}
